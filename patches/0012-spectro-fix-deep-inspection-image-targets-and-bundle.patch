From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: shphadnis <134159681+shphadnis@users.noreply.github.com>
Date: Fri, 16 Oct 2026 13:25:16 -0700
Subject: [PATCH] spectro: fix the deep-inspection image target and wire it into the bundle

Upstream's build-deep-inspection-image has never been runnable: it points at
build/deep-inspection/Containerfile-upstream, which does not exist (only
Containerfile and Containerfile-downstream ship), so upstream also punted the
target out of build-all-images/push-all-images with a NOTE saying as much.
Nothing else in the tree generates that file.

Worse, the operator bundle never carried the image either:
build-operator-bundle-image did not pass --build-arg DEEP_INSPECTION_IMAGE and
the bundle Containerfile did not declare it, so the ${DEEP_INSPECTION_IMAGE}
placeholder that operator/config/manager/manager.yaml and
operator/related_images.yaml set on the controller envsubst'ed to the empty
string, and OLM installed the operator with DEEP_INSPECTION_IMAGE unset.

That is fatal for warm vSphere plans, which run preflight deep inspection by
default (plan.spec.runPreflightInspection defaults to true): the Conversion
fails in pkg/controller/conversion/builder.go with "deep inspection container
image is not set" and the migration is marked FAILED.

Point the build at the Containerfile that exists, put the target back into the
all-images aggregates, and declare and pass the ARG so the CSV bakes the same
reference the pack ships.

Deliberately no RHEL9/XFS variant. The pack ships one deep-inspection image, so
deep_inspection_image_xfs_fqin stays unset and an xfsCompatibility conversion
still fails preflight with the error above; building the variant means a second
image to build, mirror and push, which is a separate change.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

---
 Makefile                                     | 9 +++++----
 build/forklift-operator-bundle/Containerfile | 1 +
 2 files changed, 6 insertions(+), 4 deletions(-)

diff --git a/Makefile b/Makefile
index 7eec2c3db..6878fcff1 100644
--- a/Makefile
+++ b/Makefile
@@ -386,7 +386,8 @@ build-operator-bundle-image: check_container_runtime
 		--build-arg HYPERV_PROVIDER_SERVER_IMAGE=$(HYPERV_PROVIDER_SERVER_IMAGE)$(PLATFORM_SUFFIX) \
 		--build-arg OVA_PROXY_IMAGE=$(OVA_PROXY_IMAGE)$(PLATFORM_SUFFIX) \
 		--build-arg VSPHERE_COPY_OFFLOAD_POPULATOR_IMAGE=$(VSPHERE_COPY_OFFLOAD_POPULATOR_IMAGE)$(PLATFORM_SUFFIX) \
-		--build-arg VIRT_V2V_IMAGE_RHEL9=$(VIRT_V2V_IMAGE_RHEL9)$(PLATFORM_SUFFIX)
+		--build-arg VIRT_V2V_IMAGE_RHEL9=$(VIRT_V2V_IMAGE_RHEL9)$(PLATFORM_SUFFIX) \
+		--build-arg DEEP_INSPECTION_IMAGE=$(DEEP_INSPECTION_IMAGE)$(PLATFORM_SUFFIX)
 
 push-operator-bundle-image: build-operator-bundle-image
 	$(CONTAINER_CMD) push $(OPERATOR_BUNDLE_IMAGE)$(PLATFORM_SUFFIX)
@@ -479,7 +480,7 @@ build-deep-inspection-image: check_container_runtime ## Build forklift-deep-insp
 		echo "Notice: deep-inspection image build is only supported on amd64 platform."; \
 		echo "Current platform: $(PLATFORM) - skipping deep-inspection image build."; \
 	else \
-		$(CONTAINER_CMD) build $(PLATFORM_FLAG) $(BUILD_LABEL_ARGS) -t $(DEEP_INSPECTION_IMAGE)$(PLATFORM_SUFFIX) -f build/deep-inspection/Containerfile-upstream .; \
+		$(CONTAINER_CMD) build $(PLATFORM_FLAG) $(BUILD_LABEL_ARGS) -t $(DEEP_INSPECTION_IMAGE)$(PLATFORM_SUFFIX) -f build/deep-inspection/Containerfile .; \
 	fi
 
 push-deep-inspection-image: build-deep-inspection-image ## Push forklift-deep-inspection image
@@ -491,7 +492,6 @@ push-deep-inspection-image: build-deep-inspection-image ## Push forklift-deep-in
 	fi
 
 build-all-images: ## Build all container images
-# NOTE: build-deep-inspection-image is excluded until build/deep-inspection/Containerfile-upstream exists
 build-all-images: build-api-image \
                   build-controller-image \
                   build-validation-image \
@@ -506,11 +506,11 @@ build-all-images: build-api-image \
                   build-hyperv-provider-server-image \
                   build-cli-download-image \
                   build-ova-proxy-image \
+                  build-deep-inspection-image \
                   build-operator-bundle-image \
                   build-operator-index-image
 
 push-all-images: ## Push all container images
-# NOTE: push-deep-inspection-image is excluded until build/deep-inspection/Containerfile-upstream exists
 push-all-images:  push-api-image \
                   push-controller-image \
                   push-validation-image \
@@ -525,6 +525,7 @@ push-all-images:  push-api-image \
                   push-hyperv-provider-server-image \
                   push-cli-download-image \
                   push-ova-proxy-image \
+                  push-deep-inspection-image \
                   push-operator-bundle-image \
                   push-operator-index-image
 
diff --git a/build/forklift-operator-bundle/Containerfile b/build/forklift-operator-bundle/Containerfile
index c31eed717..7fc761fb3 100644
--- a/build/forklift-operator-bundle/Containerfile
+++ b/build/forklift-operator-bundle/Containerfile
@@ -27,6 +27,7 @@ ARG OVA_PROVIDER_SERVER_IMAGE="quay.io/kubev2v/forklift-ova-provider-server:late
 ARG HYPERV_PROVIDER_SERVER_IMAGE="quay.io/kubev2v/forklift-hyperv-provider-server:latest"
 ARG VALIDATION_IMAGE="quay.io/kubev2v/forklift-validation:latest"
 ARG OVA_PROXY_IMAGE="quay.io/kubev2v/forklift-ova-proxy:latest"
+ARG DEEP_INSPECTION_IMAGE="quay.io/kubev2v/forklift-deep-inspection:latest"
 
 COPY ./operator /repo
 WORKDIR /repo
