Subject: [PATCH 09/10] spectro: update guard test for v2.12.7
 ShouldUseV2vForTransfer signature

Upstream dropped the destinationClient parameter; the NetApp-shift check
moved into Plan.HasNetAppShiftDestination(). The guard test caught it.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 pkg/apis/forklift/v1beta1/spectro_fork_test.go | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/pkg/apis/forklift/v1beta1/spectro_fork_test.go b/pkg/apis/forklift/v1beta1/spectro_fork_test.go
index 35fd27927..7493d9d2e 100644
--- a/pkg/apis/forklift/v1beta1/spectro_fork_test.go
+++ b/pkg/apis/forklift/v1beta1/spectro_fork_test.go
@@ -49,7 +49,7 @@ func TestSpectroShouldUseV2vForTransfer(t *testing.T) {
 	}
 
 	t.Run("vsphere never uses virt-v2v for transfer", func(t *testing.T) {
-		got, err := newPlan(VSphere).ShouldUseV2vForTransfer(ref.Ref{}, nil)
+		got, err := newPlan(VSphere).ShouldUseV2vForTransfer(ref.Ref{})
 		if err != nil {
 			t.Fatalf("unexpected error: %v", err)
 		}
@@ -59,7 +59,7 @@ func TestSpectroShouldUseV2vForTransfer(t *testing.T) {
 	})
 
 	t.Run("ova keeps upstream behaviour", func(t *testing.T) {
-		got, err := newPlan(Ova).ShouldUseV2vForTransfer(ref.Ref{}, nil)
+		got, err := newPlan(Ova).ShouldUseV2vForTransfer(ref.Ref{})
 		if err != nil {
 			t.Fatalf("unexpected error: %v", err)
 		}
