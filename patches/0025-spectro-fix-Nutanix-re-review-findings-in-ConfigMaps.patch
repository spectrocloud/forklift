 pkg/controller/plan/kubevirt.go               |  4 ++
 .../provider/container/nutanix/collector.go   |  6 ++-
 .../container/nutanix/collector_test.go       | 20 ++++++++
 4 files changed, 76 insertions(+), 2 deletions(-)
