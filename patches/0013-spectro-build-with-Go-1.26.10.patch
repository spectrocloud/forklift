diff --git a/build/virt-v2v/Containerfile-upstream b/build/virt-v2v/Containerfile-upstream
index 3c9d5a135..b18bde5ee 100644
--- a/build/virt-v2v/Containerfile-upstream
+++ b/build/virt-v2v/Containerfile-upstream
@@ -1,7 +1,11 @@
 # Build virt-v2v binary
 FROM quay.io/centos/centos:stream9 AS builder
 USER 0
-RUN --mount=type=cache,target=/var/cache/dnf dnf -y install --enablerepo=crb libvirt-devel golang
+RUN --mount=type=cache,target=/var/cache/dnf dnf -y install --enablerepo=crb libvirt-devel gcc pkgconf-pkg-config
+# CentOS Stream 9's golang trails RHEL's, so take the pinned Red Hat toolchain
