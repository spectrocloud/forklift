+COPY --from=registry.access.redhat.com/ubi9/go-toolset:1.26.10-1792592174 /usr/lib/golang /usr/lib/golang
+RUN ln -s /usr/lib/golang/bin/go /usr/bin/go && ln -s /usr/lib/golang/bin/gofmt /usr/bin/gofmt
 WORKDIR /app
 COPY --chown=1001:0 ./ ./
 ENV GOFLAGS="-mod=vendor -tags=strictfipsruntime"
