 cmd/kubectl-mtv/go.sum                    | 28 +++++++++---------
 cmd/vsphere-copy-offload-populator/go.mod | 23 +++++++++------
 cmd/vsphere-copy-offload-populator/go.sum | 32 ++++++++++----------
 go.mod                                    | 25 +++++++++-------
 go.sum                                    | 36 +++++++++++------------
 6 files changed, 88 insertions(+), 73 deletions(-)

