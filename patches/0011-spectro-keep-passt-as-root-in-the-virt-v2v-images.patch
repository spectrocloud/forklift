+COPY build/virt-v2v/passt_wrapper.sh /tmp/passt_wrapper.sh
+RUN if [ -x /usr/bin/passt ]; then \
+        mv /usr/bin/passt /usr/bin/passt.orig && \
+        cp /tmp/passt_wrapper.sh /usr/bin/passt && \
+        chmod 755 /usr/bin/passt && \
+        if [ -x /usr/bin/passt.avx2 ]; then \
+            ln -sf /usr/bin/passt.avx2 /usr/bin/passt.orig.avx2; \
+        fi; \
+    else \
+        echo 'passt is not installed, no wrapper needed'; \
+    fi
