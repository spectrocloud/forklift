+			client := newConnectedTestClient(t, server.URL)
+			state, err := client.PowerState(ref.Ref{ID: vmID})
+			if err != nil {
+				t.Fatalf("unexpected error for raw state %q: %v", c.raw, err)
+			}
+			if state != c.want {
+				t.Fatalf("raw state %q: expected %s, got %s", c.raw, c.want, state)
+			}
+		})
+	}
+}
