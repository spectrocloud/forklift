+		{"off", powerStateOff, planapi.VMPowerStateOff},
+		{"unknown", "", planapi.VMPowerStateUnknown},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			vmID := powerTestVMID(t, "state-"+c.name)
+			server, _, _ := newPowerTestServer(t, vmEntityPtr(vmID, c.raw))
+			defer server.Close()
