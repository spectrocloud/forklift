+// staleIDs returns the IDs present in existingIDs but absent from current.
+func staleIDs(existingIDs []string, current map[string]bool) (stale []string) {
+	for _, id := range existingIDs {
+		if !current[id] {
+			stale = append(stale, id)
+		}
+	}
+
+	return
+}
