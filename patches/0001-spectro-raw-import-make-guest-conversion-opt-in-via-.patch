From: shphadnis <134159681+shphadnis@users.noreply.github.com>
Date: Wed, 26 Aug 2026 14:06:22 -0700
Subject: [PATCH] spectro: raw import - make guest conversion opt-in via
 convertDisk

Re-derived on upstream v2.12.1 (was 8178bc0d7 on the 2.9.2 line).

Upstream RequiresConversion() returns true for VSphere/Ova/HyperV/EC2.
Spectro converts only when Provider.Spec.ConvertDisk is explicitly true,
so raw disk import is the default.

- ProviderSpec.ConvertDisk *bool (+ deepcopy, + provider CRD)
- Plan.IsSourceProviderOVA() helper used by the migration predicates

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 .../crd/bases/forklift.konveyor.io_providers.yaml      |  3 +++
 pkg/apis/forklift/v1beta1/plan.go                      |  4 ++++
 pkg/apis/forklift/v1beta1/provider.go                  | 10 +++++++++-
 pkg/apis/forklift/v1beta1/zz_generated.deepcopy.go     |  5 +++++
 4 files changed, 21 insertions(+), 1 deletion(-)

diff --git a/operator/config/crd/bases/forklift.konveyor.io_providers.yaml b/operator/config/crd/bases/forklift.konveyor.io_providers.yaml
index 0000000..0000000 100644
--- a/operator/config/crd/bases/forklift.konveyor.io_providers.yaml
+++ b/operator/config/crd/bases/forklift.konveyor.io_providers.yaml
@@ -60,6 +60,9 @@ spec:
           spec:
             description: Defines the desired state of Provider.
             properties:
+              convertDisk:
+                description: Whether or not the disk should be converted
+                type: boolean
               secret:
                 description: |-
                   References a secret containing credentials and
diff --git a/pkg/apis/forklift/v1beta1/plan.go b/pkg/apis/forklift/v1beta1/plan.go
index 0000000..0000000 100644
--- a/pkg/apis/forklift/v1beta1/plan.go
+++ b/pkg/apis/forklift/v1beta1/plan.go
@@ -536,6 +536,10 @@ func (r *Plan) IsSourceProviderOCP() bool {
 
 func (r *Plan) IsSourceProviderVSphere() bool { return r.Provider.Source.Type() == VSphere }
 
+func (r *Plan) IsSourceProviderOVA() bool {
+	return r.Provider.Source.Type() == Ova
+}
+
 func (r *Plan) ShouldRunPreflightInspection() bool {
 	return r.IsSourceProviderVSphere() &&
 		r.IsWarm() &&
diff --git a/pkg/apis/forklift/v1beta1/provider.go b/pkg/apis/forklift/v1beta1/provider.go
index 0000000..0000000 100644
--- a/pkg/apis/forklift/v1beta1/provider.go
+++ b/pkg/apis/forklift/v1beta1/provider.go
@@ -101,6 +101,8 @@ type ProviderSpec struct {
 	Secret core.ObjectReference `json:"secret" ref:"Secret"`
 	// Provider settings.
 	Settings map[string]string `json:"settings,omitempty"`
+	// Whether or not the disk should be converted
+	ConvertDisk *bool `json:"convertDisk,omitempty"`
 }
 
 // ProviderStatus defines the observed state of Provider
@@ -185,7 +187,13 @@ func (p *Provider) HasReconciled() bool {
 
 // This provider requires VM guest conversion.
 func (p *Provider) RequiresConversion() bool {
-	return p.Type() == VSphere || p.Type() == Ova || p.Type() == HyperV || p.Type() == EC2
+	// Spectro: guest conversion is opt-in. Upstream returns true for
+	// VSphere/Ova/HyperV/EC2; we convert only when explicitly requested so raw
+	// disk import is the default.
+	if p.Spec.ConvertDisk == nil {
+		return false
+	}
+	return *p.Spec.ConvertDisk
 }
 
 // This provider support the vddk aio parameters.
diff --git a/pkg/apis/forklift/v1beta1/zz_generated.deepcopy.go b/pkg/apis/forklift/v1beta1/zz_generated.deepcopy.go
index 0000000..0000000 100644
--- a/pkg/apis/forklift/v1beta1/zz_generated.deepcopy.go
+++ b/pkg/apis/forklift/v1beta1/zz_generated.deepcopy.go
@@ -1505,6 +1505,11 @@ func (in *ProviderSpec) DeepCopyInto(out *ProviderSpec) {
 			(*out)[key] = val
 		}
 	}
+	if in.ConvertDisk != nil {
+		in, out := &in.ConvertDisk, &out.ConvertDisk
+		*out = new(bool)
+		**out = **in
+	}
 }
 
 // DeepCopy is an autogenerated deepcopy function, copying the receiver, creating a new ProviderSpec.
